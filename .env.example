# Optional: your own TMDB API key for local/dev builds.
# Get one at https://www.themoviedb.org/settings/api and copy this file to
# .env.local. When this is unset, the app falls back to the built-in project
# key so development and release builds keep working without extra setup.
NEXT_PUBLIC_TMDB_API_KEY=

# Optional: AniList access token. Public anime catalog queries do not require
# one, so leave this empty unless you need authenticated AniList requests.
NEXT_PUBLIC_ANILIST_API_KEY=
